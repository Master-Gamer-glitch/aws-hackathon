# Copy to .env.local and adjust. .env.local is git-ignored.

# --- Server-side (read by next.config.mjs) -----------------------------------
# REST API Gateway URL incl. stage. Browser calls to /api/airstream/* are proxied here.
# (Find it with: aws apigateway get-rest-apis --region us-west-2 --profile crewdesk)
AIRSTREAM_API_URL=https://hdnq75ygs3.execute-api.us-west-2.amazonaws.com/Prod

# --- Browser-side (NEXT_PUBLIC_*, baked in at build time) ---------------------
# WebSocket API endpoint (stack output "WebSocketApiEndpoint"). A different API than REST.
NEXT_PUBLIC_WS_BASE_URL=wss://34gffaaf1a.execute-api.us-west-2.amazonaws.com/dev

# Backend project whose tasks/rooms the UI shows.
NEXT_PUBLIC_PROJECT_ID=proj_demo

# Optional: call REST directly instead of via the proxy. Only works once the backend
# sends CORS headers on real responses, or for a static host without a Node server.
# NEXT_PUBLIC_API_BASE_URL=https://hdnq75ygs3.execute-api.us-west-2.amazonaws.com/Prod
